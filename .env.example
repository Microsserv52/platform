# Platform environment template. Copy to .env; never commit the real .env file.
#
# Three independent run modes:
#   1. Daily Docker Compose  -> `docker compose up -d`            (local section)
#   2. LocalStack rehearsal  -> `scripts/localstack-up.sh`        (localstack section)
#   3. Real AWS deployment   -> `scripts/deploy-aws.sh`           (aws section)
#
# WARNING: the values below are unsafe local placeholders. Replace at minimum
# POSTGRES_PASSWORD, JWT_SECRET, INTERNAL_SERVICE_SECRET and
# EXCHANGE_PROVIDER_API_KEY before exposing the stack anywhere.

# ---------------------------------------------------------------------------
# Shared application values
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_SECRET=replace-with-a-random-service-secret
ACCESS_TOKEN_EXPIRATION_SECONDS=900
DISPLAY_TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# Daily Docker Compose (unchanged defaults)
# ---------------------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=platform
CACHE_REDIS_URL=redis://redis:6379
CACHE_ENABLED=false
CACHE_TTL_SECONDS=60

# Local-only Account admin bootstrap. Leave both empty to disable it.
ADMIN_EMAIL=
ADMIN_PASSWORD=

PRODUCT_IMAGE_MODE=mock
PRODUCT_IMAGE_STORAGE_URL=http://image-storage:8090

EXCHANGE_PROVIDER_URL=http://exchange-provider-mock:8080
EXCHANGE_PROVIDER_API_KEY=replace-with-a-local-provider-key

ACCOUNT_IMAGE=microsserv52-account:local
AUTH_IMAGE=microsserv52-auth:local
EXCHANGE_IMAGE=microsserv52-exchange:local
GATEWAY_IMAGE=microsserv52-gateway:local
ORDER_IMAGE=microsserv52-order:local
PRODUCT_IMAGE=microsserv52-product:local

# ---------------------------------------------------------------------------
# LocalStack rehearsal (scripts/localstack-up.sh)
# ---------------------------------------------------------------------------
# Student/paid token. Hobby does not include EKS, ECR, RDS, ElastiCache or
# CloudFront, which this rehearsal needs.
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_IMAGE=localstack/localstack:2026.10.8
LOCALSTACK_SERVICES=s3,cloudfront,rds,elasticache,eks,ecr,iam,sts,ec2
LOCALSTACK_HOST=localhost.localstack.cloud:4566
LOCALSTACK_PERSISTENCE=1
LOCALSTACK_ENDPOINT=http://localhost:4566
# Optional override for the address pods use to reach LocalStack. When empty,
# the script uses the LocalStack container IP on the k3d network.
LOCALSTACK_HOST_IP=

# AWS endpoint values for the LocalStack rehearsal are set by
# scripts/localstack-up.sh. Do not store dummy AWS_ACCESS_KEY_ID values in this
# file: scripts/deploy-aws.sh loads .env and must use your real AWS profile.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# ---------------------------------------------------------------------------
# Real AWS deployment (scripts/deploy-aws.sh)
# ---------------------------------------------------------------------------
# Do not put long-lived AWS keys here. Log in first:
#   aws sso login --profile platform && export AWS_PROFILE=platform
# or:
#   aws configure --profile platform
# Uncomment and set the profile you use for `aws sso login`.
# AWS_PROFILE=platform
# Empty auto-creates platform-tfstate-<account-id>.
TF_STATE_BUCKET=
TF_STATE_KEY=platform/aws.tfstate

# Real Exchange provider. Kept separate from the local Compose mock URL above
# so a local value cannot leak into an AWS deployment. If unset, the script
# falls back to a non-mock EXCHANGE_PROVIDER_URL.
DEPLOY_EXCHANGE_PROVIDER_URL=
# Optional when the provider does not require authentication.
DEPLOY_EXCHANGE_PROVIDER_API_KEY=
DEPLOY_EXCHANGE_PROVIDER_REQUIRES_API_KEY=false

# Optional overrides consumed by Terraform as TF_VAR_*.
TF_VAR_project=platform
TF_VAR_vpc_cidr=10.0.0.0/16
TF_VAR_kubernetes_version=1.35
TF_VAR_node_instance_types=["t3.medium"]
TF_VAR_node_capacity_type=ON_DEMAND
TF_VAR_node_desired_size=2
TF_VAR_node_min_size=2
TF_VAR_node_max_size=6
TF_VAR_rds_instance_class=db.t4g.micro
TF_VAR_redis_node_type=cache.t4g.micro
TF_VAR_domain_name=
TF_VAR_api_domain_name=
TF_VAR_hosted_zone_id=
TF_VAR_create_dns=false
TF_VAR_acm_certificate_arn=
# Gateway NLB DNS when publishing the frontend through CloudFront /api/*.
TF_VAR_cloudfront_api_origin_domain=
TF_VAR_admin_principal_arn=
# Must include the admin origin that performs browser uploads.
# Optional extra browser origins. The CloudFront domain and any configured
# aliases are added automatically by Terraform.
TF_VAR_cors_allowed_origins=[]
TF_VAR_cloudfront_api_origin_protocol_policy=http-only
# Prepare EBS CSI and Grafana secret containers; does not deploy Grafana.
TF_VAR_enable_observability=false
# Prepare CloudFront /faro/* to Alloy through the existing NLB (does not deploy).
TF_VAR_enable_faro_ingest=false
# Prepare AWS WAF managed rules + rate limit for CloudFront; does not deploy.
TF_VAR_enable_waf=false

# ---------------------------------------------------------------------------
# Frontend build and CDN deployment (scripts/sync-frontends.sh)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_DISPLAY_TIME_ZONE=UTC
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_ENABLE_TELEMETRY=false
NEXT_PUBLIC_FARO_URL=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_DOMAINS=
NEXT_PUBLIC_GRAFANA_DASHBOARD_URL=
NEXT_PUBLIC_UMAMI_DASHBOARD_URL=
NEXT_PUBLIC_ENABLE_PRODUCT_IMAGE_UPLOADS=true
NEXT_PUBLIC_IMAGE_UPLOAD_ORIGINS=

# ---------------------------------------------------------------------------
# Manual demo seeder (never deployed)
# ---------------------------------------------------------------------------
DEMO_BASE_URL=https://app.example.com/api

# ---------------------------------------------------------------------------
# Local observability profile (compose.observability.yml)
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# Change this before exposing Grafana beyond localhost.
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000
ALERT_EMAIL_TO=ops@example.invalid
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM_ADDRESS=
GRAFANA_SMTP_FROM_NAME=Platform alerts
# Browser telemetry is opt-in. The observability Compose profile overrides this
# to true for local builds; set it explicitly for production builds.
NEXT_PUBLIC_ENABLE_TELEMETRY=false
# Local same-origin Faro path; nginx forwards /faro/* to Alloy.
NEXT_PUBLIC_FARO_URL=http://localhost:8080/faro/collect
FARO_ALLOWED_ORIGINS=http://localhost:8080
# OpenTelemetry Java agent version used by Compose and the Kubernetes init container.
OTEL_JAVAAGENT_VERSION=v2.34.0
OTEL_TRACES_SAMPLER_ARG=0.2

# Optional Grafana Cloud collector credentials (observability/alloy/config.cloud.alloy).
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_PYROSCOPE_URL=
GRAFANA_CLOUD_PYROSCOPE_USER=
GRAFANA_CLOUD_API_KEY=
GRAFANA_CLOUD_STACK_ID=
GRAFANA_CLOUD_SM_URL=

# Terraform variables for terraform/environments/grafana-cloud.
TF_VAR_grafana_url=
TF_VAR_grafana_auth=
TF_VAR_grafana_sm_access_token=
TF_VAR_grafana_sm_url=
