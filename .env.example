# Local Compose configuration. Copy to .env; never commit the real .env file.
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=platform
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_SECRET=replace-with-a-random-service-secret
ACCESS_TOKEN_EXPIRATION_SECONDS=900
DISPLAY_TIME_ZONE=UTC
# Services receive CACHE_REDIS_URL; set this to Redis Cloud or another
# reachable Redis deployment when local Redis is not used.
CACHE_REDIS_URL=redis://redis:6379
# Optional: defaults to the local Compose mock. Set both for a real provider.
EXCHANGE_PROVIDER_URL=http://exchange-provider-mock:8080
EXCHANGE_PROVIDER_API_KEY=local-development

# Product and Exchange are external service images and must be available locally
# or in a registry accessible by Docker.
ACCOUNT_IMAGE=microsserv52-account:local
AUTH_IMAGE=microsserv52-auth:local
EXCHANGE_IMAGE=microsserv52-exchange:local
GATEWAY_IMAGE=microsserv52-gateway:local
ORDER_IMAGE=microsserv52-order:local
PRODUCT_IMAGE=microsserv52-product:local

# Production EKS values are configured as GitHub Actions secrets/variables,
# not in the local .env file.
AWS_REGION=us-east-1
EKS_CLUSTER_NAME=platform
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
