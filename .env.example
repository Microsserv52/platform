# Local Compose defaults. Never commit the real .env file or production values.
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=platform
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_SECRET=replace-with-a-random-service-secret
ACCESS_TOKEN_EXPIRATION_SECONDS=900

# AWS/EKS deployment secrets (configure these as GitHub Actions secrets).
AWS_REGION=us-east-1
EKS_CLUSTER_NAME=platform
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
SPRING_DATASOURCE_URL=jdbc:postgresql://your-rds-endpoint:5432/platform
SPRING_DATASOURCE_USERNAME=platform
SPRING_DATASOURCE_PASSWORD=replace-in-github-secrets
