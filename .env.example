# Local Compose configuration. Copy to .env; never commit the real .env file.
#
# WARNING — these are unsafe local-development placeholders. Before exposing
# this stack to anyone (or deploying it anywhere), you MUST replace at minimum:
#   POSTGRES_PASSWORD, JWT_SECRET, INTERNAL_SERVICE_SECRET, EXCHANGE_PROVIDER_API_KEY
# with real values from a secret manager. The Compose defaults are used
# verbatim by the examples and are not safe anywhere else.
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=platform
# Shared by Gateway, Auth, Account, Order, Product and Exchange. They must all
# use the same value or authenticated calls fail with 401 / 403.
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_SECRET=replace-with-a-random-service-secret
ACCESS_TOKEN_EXPIRATION_SECONDS=900
DISPLAY_TIME_ZONE=UTC
# Services receive CACHE_REDIS_URL; set this to Redis Cloud or another
# reachable Redis deployment when local Redis is not used.
CACHE_REDIS_URL=redis://redis:6379
# Optional LOCAL-ONLY admin bootstrap for the Account service. Leave BOTH empty
# (default) to disable it. When both are set, the account with this email is
# created with ROLE_ADMIN (or promoted if it already exists; passwords of
# existing accounts are never overwritten) on service startup.
# The local Compose fallback below only applies when these are unset, and the
# bootstrap refuses to run when ENV/APP_ENV/SPRING_PROFILES_ACTIVE marks a
# production environment. The same values are reused by the optional demo
# seeder (docker compose --profile demo up demo-seeder). Never set these in
# real environments; promote real accounts manually instead (see
# docs/development/get_started.md).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: defaults to the local image-storage mock (see mocks/image-storage).
# Set PRODUCT_IMAGE_MODE=s3 plus PRODUCT_IMAGE_S3_BUCKET/REGION/MEDIA_ORIGIN for
# a real AWS S3 bucket instead.
PRODUCT_IMAGE_MODE=mock
PRODUCT_IMAGE_STORAGE_URL=http://image-storage:8090

# Optional: defaults to the local Compose mock. Set both for a real provider.
EXCHANGE_PROVIDER_URL=http://exchange-provider-mock:8080
EXCHANGE_PROVIDER_API_KEY=replace-with-a-local-provider-key

# Product and Exchange are external service images and must be available locally
# or in a registry accessible by Docker.
ACCOUNT_IMAGE=microsserv52-account:local
AUTH_IMAGE=microsserv52-auth:local
EXCHANGE_IMAGE=microsserv52-exchange:local
GATEWAY_IMAGE=microsserv52-gateway:local
ORDER_IMAGE=microsserv52-order:local
PRODUCT_IMAGE=microsserv52-product:local

# Production EKS values are configured as GitHub Actions secrets/variables,
# not in the local .env file.
AWS_REGION=us-east-1
EKS_CLUSTER_NAME=platform
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
